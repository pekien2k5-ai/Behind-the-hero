{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test & Verify l4ngx's jobs (81 Tests)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tools/CoreTests/CoreTests.csproj",
                "--logger:console;verbosity=normal"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild Art Assets (Spritesheets, Tileset, VFX)",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/Tools/slice_assets.py"
            ],
            "group": "build"
        }
    ]
}
